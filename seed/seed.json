	"blockTypes": [
		{
			"slug": "portfolio_statement",
			"label": "Statement",
			"description": "A large statement with an optional small label beside it. As the first block, it is the page heading. Line breaks are kept.",
			"icon": "quotes",
			"category": "Portfolio",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "text",
							"label": "Statement",
							"type": "text",
							"required": true,
							"validation": {
								"maxLength": 160
							}
						},
						{
							"slug": "label",
							"label": "Small label",
							"type": "string",
							"validation": {
								"maxLength": 40
							}
						}
					]
				}
			]
		},
		{
			"slug": "portfolio_selected_work",
			"label": "Selected work",
			"description": "Projects with Feature on home page switched on, newest first and up to 12, or the six newest when none are.",
			"icon": "grid-four",
			"category": "Portfolio",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "heading",
							"label": "Heading",
							"type": "string",
							"required": true,
							"defaultValue": "Selected work",
							"validation": {
								"maxLength": 40
							}
						}
					]
				}
			]
		},
		{
			"slug": "portfolio_clients",
			"label": "Clients",
			"description": "A line of client names",
			"icon": "handshake",
			"category": "Portfolio",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "heading",
							"label": "Heading",
							"type": "string",
							"required": true,
							"defaultValue": "Clients",
							"validation": {
								"maxLength": 40
							}
						},
						{
							"slug": "clients",
							"label": "Clients",
							"type": "repeater",
							"required": true,
							"validation": {
								"minItems": 1,
								"maxItems": 40,
								"subFields": [
									{
										"slug": "name",
										"label": "Name",
										"type": "string",
										"required": true
									}
								]
							}
						}
					]
				}
			]
		},
		{
			"slug": "portfolio_contact",
			"label": "Contact details",
			"description": "A heading, an introduction, a large email link and studio details, followed by the social profiles from Settings. As the first block, it is the page heading.",
			"icon": "envelope-simple",
			"category": "Portfolio",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "heading",
							"label": "Heading",
							"type": "string",
							"required": true,
							"defaultValue": "Get in touch",
							"validation": {
								"maxLength": 80
							}
						},
						{
							"slug": "label",
							"label": "Small label",
							"type": "string",
							"validation": {
								"maxLength": 40
							}
						},
						{
							"slug": "intro",
							"label": "Introduction",
							"type": "text",
							"validation": {
								"maxLength": 400
							}
						},
						{
							"slug": "email",
							"label": "Email address",
							"type": "string",
							"required": true,
							"validation": {
								"maxLength": 254,
								"pattern": "^[^\\s@:/]+@[^\\s@:/]+\\.[^\\s@:/]+$"
							}
						},
						{
							"slug": "email_label",
							"label": "Label above the email in the details",
							"type": "string",
							"defaultValue": "Email",
							"validation": {
								"maxLength": 40
							}
						},
						{
							"slug": "details",
							"label": "Studio details",
							"type": "repeater",
							"validation": {
								"maxItems": 6,
								"subFields": [
									{
										"slug": "label",
										"label": "Label",
										"type": "string",
										"required": true
									},
									{
										"slug": "text",
										"label": "Text",
										"type": "string",
										"required": true
									},
									{
										"slug": "note",
										"label": "Note (smaller, below the text)",
										"type": "string"
									}
								]
							}
						}
					]
				}
			]
		}
	],
	"collections": [
		{
			"slug": "projects",
