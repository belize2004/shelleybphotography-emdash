			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "Meet Shelley & Blaine Bressman",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "My name is Shelley. In 2021 my church was in need of a photographer. After a month of using equipment I had for 20 years, I decided it was time to invest in newer, better gear — and to start doing photography professionally. I haven’t looked back."
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Published in The Wall Street Journal"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "In early 2023, the Wall Street Journal commissioned me to photograph a retired couple in Orange Beach, including their home on Ono Island and portraits on the beach. It was published in the prestigious Global Luxury Mansion section."
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Husband & Wife Photography Team"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "My husband Blaine and I now shoot together. I focus on natural posing, lighting, and connection, while Blaine watches for those candid, unscripted moments that make your family unique. Together, we bring a seamless, stress-free experience to your sunset beach session."
								}
							]
						}
					]
				}
			},
			{
				"id": "contact",
				"slug": "contact",
				"status": "published",
				"data": {
					"title": "Contact",
					"layout": [
						{
							"_type": "portfolio_contact",
							"_version": 1,
							"_key": "contact-block",
							"heading": "Let’s create heirloom portraits together",
							"label": "Inquire Session",
							"intro": "Tell us about your family, your vacation dates, and where you are staying along the Gulf Coast. We will follow up promptly with availability and package details.",
							"email": "shelley@shelleybphotography.com",
							"email_label": "Direct Email",
							"details": [
