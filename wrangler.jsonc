{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shelleyb-photography",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shelleyb-photography-db",
			"database_id": "shelleyb-photography-db"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "shelleyb-photography-media"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }]
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
	},
	"triggers": {
		"crons": ["* * * * *"]
	}
}
