---
// Header / Masthead for Shelley B Photography inspired by Dixon Creative Editorial
---

<section class="editorial-masthead">
	<div class="masthead-inner">
		<div class="masthead-brand-mark">
			<div class="brand-crest">
				<img src="/images/logo.avif" alt="Shelley B Photography" class="crest-img" />
			</div>
			<span class="crest-label">EST. EMERALD COAST, 2021</span>
		</div>

		<div class="masthead-content">
			<div class="masthead-badge-row">
				<span class="masthead-volume">THE EDITORIAL LOOKBOOK · VOL. 2026</span>
				<span class="masthead-pill">Pensacola Beach · Gulf Shores · Orange Beach</span>
			</div>
			<h1 class="masthead-title">Fine-Art Beach & Senior Portraits</h1>
			<h3 class="masthead-subtitle">Authentic moments. <em>Heirloom artistry.</em></h3>
			<p class="masthead-lead">
				Sunset and sunrise coastal portraiture by husband & wife duo <strong>Shelley & Blaine Bressman</strong>. 
				Published in <em>The Wall Street Journal</em> & <em>Pensacola Magazine</em>. Crafted with intentional lighting, genuine connection, and unhurried ease.
			</p>

			<div class="masthead-stats-bar">
				<div class="stat-cell">
					<strong>100+</strong>
					<span>Five-Star Reviews</span>
				</div>
				<div class="stat-divider">/</div>
				<div class="stat-cell">
					<strong>WSJ</strong>
					<span>Published Feature</span>
				</div>
				<div class="stat-divider">/</div>
				<div class="stat-cell">
					<strong>2 Shooters</strong>
					<span>Posing & Candid Team</span>
				</div>
			</div>
		</div>

		<div class="masthead-action-box">
			<a href="#inquire" class="masthead-cta">
				<span>Reserve Your Date</span>
				<span class="arrow">↗</span>
			</a>
			<a href="tel:8504905147" class="masthead-phone">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
				(850) 490-5147
			</a>
			<span class="masthead-note">Serving AL & FL Gulf Coast</span>
		</div>
	</div>

	<!-- Curated Session Highlights Bar (Strip Rings) -->
	<div class="session-strip" role="region" aria-label="Curated session highlights">
		<a class="session-strip-item" href="#lookbook" data-filter="all">
			<div class="strip-ring">
				<div class="strip-thumb">
					<img src="https://shelleybphotography.com/photos/medium/0bc30285-6121-434d-9091-445aaf08499e.avif/" alt="Beach Family Portraits" loading="lazy" />
				</div>
			</div>
			<span class="strip-title">Beach Family</span>
			<small class="strip-count">Signature Sessions</small>
		</a>

		<a class="session-strip-item" href="#lookbook" data-filter="Gulf Shores">
			<div class="strip-ring">
				<div class="strip-thumb">
					<img src="https://shelleybphotography.com/photos/medium/08509244-ce3d-46f3-ad6f-cf3fdd689789.avif/" alt="Gulf Shores Portraits" loading="lazy" />
				</div>
			</div>
			<span class="strip-title">Gulf Shores</span>
			<small class="strip-count">Dunes & White Sand</small>
		</a>

		<a class="session-strip-item" href="#lookbook" data-filter="Orange Beach & Pensacola">
			<div class="strip-ring">
				<div class="strip-thumb">
					<img src="https://shelleybphotography.com/photos/medium/d7fbc79a-85df-48cc-bbe6-c73e7375de2c.avif/" alt="WSJ & Orange Beach" loading="lazy" />
				</div>
			</div>
			<span class="strip-title">Orange Beach & WSJ</span>
			<small class="strip-count">Published Luxury</small>
		</a>

		<a class="session-strip-item" href="#lookbook" data-filter="Perdido Key">
			<div class="strip-ring">
				<div class="strip-thumb">
					<img src="https://shelleybphotography.com/photos/medium/39229855-85c8-446f-a7c8-04ea40a5ef08.avif/" alt="Perdido Key Portraits" loading="lazy" />
				</div>
			</div>
			<span class="strip-title">Perdido Key</span>
			<small class="strip-count">State Park Dunes</small>
		</a>
	</div>
</section>

<style>
	.editorial-masthead {
		padding-block-start: clamp(1rem, 2vw, 2.5rem);
		padding-block-end: clamp(2rem, 3vw, 4rem);
		border-bottom: 1px solid var(--color-border);
	}

	.masthead-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: clamp(1.5rem, 3vw, 4rem);
		align-items: center;
		max-width: var(--frame-width);
		margin-inline: auto;
		padding-inline: var(--page-margin);
	}

	.masthead-brand-mark {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.brand-crest {
		width: clamp(80px, 9vw, 130px);
		height: clamp(80px, 9vw, 130px);
		border-radius: 50%;
		border: 1px solid rgba(201, 169, 110, 0.35);
		padding: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(circle, rgba(201, 169, 110, 0.12) 0%, transparent 70%);
	}

	.crest-img {
		max-width: 85%;
		max-height: 85%;
		object-fit: contain;
		filter: brightness(0) invert(1);
	}

	.crest-label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	.masthead-badge-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.masthead-volume {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: 500;
	}

	.masthead-pill {
		font-family: var(--font-body);
		font-size: 0.75rem;
		padding: 2px 10px;
		border-radius: var(--radius-full);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--color-border);
		color: var(--color-text-secondary);
	}

	.masthead-title {
		font-family: var(--font-heading);
		font-size: clamp(2.4rem, 4.5vw, 4.2rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0;
		color: var(--color-text);
	}

	.masthead-subtitle {
		font-family: var(--font-heading);
		font-size: clamp(1.4rem, 2.3vw, 2.1rem);
		font-weight: 400;
		margin-top: 0.35rem;
		color: var(--color-accent-light);
	}

	.masthead-subtitle em {
		font-style: italic;
		color: var(--color-accent);
	}

	.masthead-lead {
		max-width: 60ch;
		margin-top: 1rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.masthead-lead strong {
		color: var(--color-text);
	}

	.masthead-stats-bar {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2vw, 2rem);
		margin-top: 1.75rem;
		padding-block: 0.75rem;
		border-top: 1px solid var(--color-border);
	}

	.stat-cell {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.stat-cell strong {
		font-family: var(--font-heading);
		font-size: 1.35rem;
		color: var(--color-text);
	}

	.stat-cell span {
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.stat-divider {
		color: var(--color-border-strong);
		font-size: 1.25rem;
		font-weight: 300;
	}

	.masthead-action-box {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid rgba(201, 169, 110, 0.3);
		border-radius: var(--radius);
		background: radial-gradient(circle at 100% 0%, rgba(201, 169, 110, 0.08) 0%, rgba(20, 20, 20, 0.7) 100%);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
	}

	.masthead-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--color-accent);
		color: #111111;
		padding: 0.75rem 1.4rem;
		font-weight: 600;
		font-size: 0.875rem;
		border-radius: var(--radius);
		text-decoration: none;
		transition: transform 0.2s ease, background 0.2s ease;
	}

	.masthead-cta:hover {
		background: var(--color-accent-light);
		transform: translateY(-2px);
		color: #111111;
	}

	.masthead-phone {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-text-secondary);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
	}

	.masthead-phone:hover {
		color: var(--color-accent);
	}

	.masthead-note {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	/* Highlights Strip */
	.session-strip {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: clamp(1rem, 3vw, 3.5rem);
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--color-border);
		max-width: var(--frame-width);
		margin-inline: auto;
		padding-inline: var(--page-margin);
	}

	.session-strip-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: var(--color-text);
		transition: transform 0.2s ease;
	}

	.session-strip-item:hover {
		transform: translateY(-4px);
	}

	.strip-ring {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		padding: 3px;
		border: 1.5px solid var(--color-accent);
		background: rgba(201, 169, 110, 0.15);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.session-strip-item:hover .strip-ring {
		box-shadow: 0 0 15px rgba(201, 169, 110, 0.5);
	}

	.strip-thumb {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
	}

	.strip-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.strip-title {
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 500;
	}

	.strip-count {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: var(--color-muted);
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		.masthead-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.masthead-badge-row {
			justify-content: center;
		}

		.masthead-stats-bar {
			justify-content: center;
		}

		.masthead-action-box {
			align-items: center;
		}
	}
</style>
