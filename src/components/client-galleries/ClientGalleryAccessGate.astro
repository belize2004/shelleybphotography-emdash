---
interface Props {
  galleryId: string;
  galleryTitle: string;
  artistName: string;
  coverImageUrl?: string;
  requirePassword?: boolean;
  requireEmail?: boolean;
  clientName?: string | null;
  eventDate?: string | null;
}

const {
  galleryId,
  galleryTitle,
  artistName,
  coverImageUrl,
  requirePassword = true,
  requireEmail = false,
  clientName,
  eventDate,
} = Astro.props;
---

<section class="lumio-client-access-gate" aria-labelledby="gate-title">
  {coverImageUrl && (
    <div class="lumio-client-gate-bg" style={`background-image: url('${coverImageUrl}')`}></div>
  )}
  <div class="lumio-client-gate-card">
    <div class="lumio-client-gate-header">
      <p class="lumio-client-gate-artist">{artistName}</p>
      <h1 id="gate-title" class="lumio-client-gate-title">{galleryTitle}</h1>
      {(clientName || eventDate) && (
        <p class="lumio-client-gate-subtitle">
          {clientName && <span>Prepared for {clientName}</span>}
          {clientName && eventDate && <span> · </span>}
          {eventDate && <span>{eventDate}</span>}
        </p>
      )}
    </div>

    <form class="lumio-client-gate-form" data-client-access-form>
      <input type="hidden" name="galleryId" value={galleryId} />
      
      {requirePassword && (
        <label class="lumio-gate-field">
          <span>Gallery Password</span>
          <input
            type="password"
            name="password"
            placeholder="Enter password"
            autocomplete="current-password"
            required
          />
        </label>
      )}

      {requireEmail && (
        <label class="lumio-gate-field">
          <span>Your Email</span>
          <input
            type="email"
            name="visitorEmail"
            placeholder="name@example.com"
            autocomplete="email"
            required
          />
        </label>
      )}

      {!requireEmail && (
        <label class="lumio-gate-field">
          <span>Your Name (Optional)</span>
          <input
            type="text"
            name="visitorName"
            placeholder="First and last name"
            autocomplete="name"
          />
        </label>
      )}

      <button type="submit" class="lumio-gate-submit-btn">
        Enter Gallery
      </button>

      <p class="lumio-gate-error" data-gate-error hidden></p>
    </form>
  </div>
</section>

<script is:inline>
  const form = document.querySelector("[data-client-access-form]");
  const errorEl = document.querySelector("[data-gate-error]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector("button[type='submit']");
    const originalText = btn?.textContent || "Enter Gallery";
    
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Verifying...";
    }
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = "";
    }

    try {
      const formData = new FormData(form);
      const res = await fetch("/api/client-galleries/auth", {
        method: "POST",
        body: formData,
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok || !data.ok) {
        throw new Error(data.error || "Access denied. Please check your credentials.");
      }

      if (data.visitorSessionId) {
        sessionStorage.setItem("lumio_visitor_session_id", data.visitorSessionId);
      }

      window.location.reload();
    } catch (err) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = err.message || "Failed to enter gallery.";
      }
      if (btn) {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }
  });
</script>

<style>
  .lumio-client-access-gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0f1115;
    color: #fff;
    padding: 24px;
    overflow: hidden;
  }

  .lumio-client-gate-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(28px) brightness(0.35);
    transform: scale(1.1);
    z-index: 1;
  }

  .lumio-client-gate-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 440px;
    background: rgba(18, 21, 27, 0.88);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 40px 36px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .lumio-client-gate-artist {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 8px;
  }

  .lumio-client-gate-title {
    font-family: "Montserrat", sans-serif;
    font-size: 26px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 10px;
  }

  .lumio-client-gate-subtitle {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 28px;
  }

  .lumio-client-gate-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }

  .lumio-gate-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .lumio-gate-field span {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .lumio-gate-field input {
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: #fff;
    padding: 0 14px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.18s ease;
  }

  .lumio-gate-field input:focus {
    border-color: #fff;
  }

  .lumio-gate-submit-btn {
    margin-top: 10px;
    height: 46px;
    background: #fff;
    color: #000;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .lumio-gate-submit-btn:hover {
    background: #e5e5e5;
  }

  .lumio-gate-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .lumio-gate-error {
    margin-top: 12px;
    font-size: 13px;
    color: #ff7b7b;
    text-align: center;
  }
</style>
