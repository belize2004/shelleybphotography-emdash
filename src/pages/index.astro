---
import {
	getEditMeta,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import EditorialMasthead from "../components/EditorialMasthead.astro";
import DixonLookbookGrid from "../components/DixonLookbookGrid.astro";
import ExperiencePricing from "../components/ExperiencePricing.astro";
import InquiryForm from "../components/InquiryForm.astro";

const [settings, homeResult] = await Promise.all([
	getSiteSettings(),
	getEmDashEntry("pages", "home"),
]);

const home = homeResult.entry;
const siteTitle = settings?.title || "Shelley B Photography";

const seo = home
	? getSeoMeta(home, {
			siteUrl: Astro.url.origin,
			path: "/",
			defaultTitle: `${siteTitle} | Gulf Coast Family Beach & Senior Portraits`,
			defaultDescription:
				"Luxury Gulf Coast beach portraits & editorial senior photography by Shelley & Blaine Bressman. Serving Pensacola Beach, Gulf Shores, and Orange Beach.",
		})
	: null;
---

<Base
	title={seo?.title ?? `${siteTitle} | Gulf Coast Family Beach Portraits`}
	pageTitle={seo?.ogTitle ?? siteTitle}
	description={seo?.description ?? "Fine-art beach family portraits in Gulf Shores, Orange Beach & Pensacola."}
	image={seo?.ogImage ?? "https://shelleybphotography.com/images/hero.jpg"}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={home
		? { collection: "pages", id: home.data.id, slug: home.id }
		: undefined}
>
	<!-- Dixon Creative Luxury Site Header -->
	<SiteHeader />

	<!-- Editorial Studio Masthead Header & Session Strip -->
	<EditorialMasthead />

	<!-- Dixon Creative 3-Column Luxury Lookbook Card Grid -->
	<DixonLookbookGrid />

	<!-- The Experience, Husband & Wife Bio, Reviews, and Pricing Collections -->
	<ExperiencePricing />

	<!-- Session Inquiry / Booking Drawer Form -->
	<InquiryForm />
</Base>
