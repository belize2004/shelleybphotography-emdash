---
import {
	getEditMeta,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import DixonLookbookGrid from "../components/DixonLookbookGrid.astro";
import ExperiencePricing from "../components/ExperiencePricing.astro";
import InquiryForm from "../components/InquiryForm.astro";

const [settings, homeResult] = await Promise.all([
	getSiteSettings(),
	getEmDashEntry("pages", "home"),
]);

const home = homeResult.entry;
const siteTitle = settings?.title || "Shelley B Photography";

const seo = home
	? getSeoMeta(home, {
			siteUrl: Astro.url.origin,
			path: "/",
			defaultTitle: `${siteTitle} | Senior, Sports & Milestone Photography`,
			defaultDescription:
				"Editorial-style portraits and fine-art coastal photography by Shelley & Blaine Bressman. Serving Gulf Shores, Orange Beach, and Pensacola.",
		})
	: null;
---

<Base
	title={seo?.title ?? `${siteTitle} | Senior, Sports & Milestone Photography`}
	pageTitle={seo?.ogTitle ?? siteTitle}
	description={seo?.description ?? "Editorial-style portraits by Shelley B Photography"}
	image={seo?.ogImage ?? "https://shelleybphotography.com/images/hero.jpg"}
	canonical={seo?.canonical}
	robots={seo?.robots}
	hideHeader={true}
	content={home
		? { collection: "pages", id: home.data.id, slug: home.id }
		: undefined}
>
	<!-- Single Clean Dixon Creative Header -->
	<SiteHeader />

	<!-- Dixon Creative 3-Column Luxury Lookbook Card Grid (First & Prominent) -->
	<DixonLookbookGrid />

	<!-- The Experience & All-Inclusive Pricing Collections -->
	<ExperiencePricing />

	<!-- Session Inquiry / Booking Drawer Form -->
	<InquiryForm />
</Base>
